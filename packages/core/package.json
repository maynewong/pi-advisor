{
	"name": "@maynewong/pi-advisor-core",
	"version": "0.1.0",
	"license": "MIT",
	"description": "Headless runtime for running isolated Pi Advisor reviews and external Advisor runtimes.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maynewong/pi-advisor.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/maynewong/pi-advisor/tree/main/packages/core#readme",
	"bugs": {
		"url": "https://github.com/maynewong/pi-advisor/issues"
	},
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"files": [
		"src/**/*.ts",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"minimatch": "10.2.5",
		"yaml": "2.9.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
