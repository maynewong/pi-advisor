{
	"name": "pi-subagent-ux",
	"version": "0.1.0",
	"type": "module",
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./agents/*": "./agents/*.md"
	},
	"keywords": ["pi-package"],
	"pi": {
		"extensions": ["./extensions"]
	},
	"files": [
		"src",
		"extensions",
		"agents",
		"README.md"
	],
	"scripts": {
		"test": "vitest --run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"pi-subagent-core": "^0.1.0"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
